---
// apps/docs/src/components/CodeSwitcher.astro
---

<section class="my-20 px-4 max-w-7xl mx-auto">
  <div class="text-center max-w-3xl mx-auto mb-10">
    <h2 class="text-3xl md:text-5xl font-extrabold text-slate-900 dark:text-white">
      Dead Simple Integration
    </h2>
    <p class="mt-4 text-base md:text-lg text-slate-600 dark:text-slate-400">
      Use raw WebGL2, lightweight Svelte actions, React components, or headless Node.js exports.
    </p>
  </div>

  <div class="max-w-4xl mx-auto rounded-2xl bg-slate-950 border border-slate-800 overflow-hidden shadow-2xl">
    <div class="flex items-center justify-between px-4 py-3 bg-slate-900/80 border-b border-slate-800">
      <div class="flex items-center gap-2">
        <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
        <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
        <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
        <span class="ml-2 font-mono text-xs text-slate-400">vanilla / react / svelte</span>
      </div>
      <div class="text-xs font-mono text-purple-400">TypeScript</div>
    </div>

    <div class="p-6 overflow-x-auto text-xs md:text-sm font-mono leading-relaxed text-slate-200">
      <pre><code><span class="text-purple-400">import</span> &#123; mountEffect &#125; <span class="text-purple-400">from</span> <span class="text-emerald-400">"@pixerate/flair/embed"</span>;
<span class="text-purple-400">import</span> &#123; loadEffect &#125; <span class="text-purple-400">from</span> <span class="text-emerald-400">"@pixerate/flair/catalog/lazy"</span>;

<span class="text-slate-500">// 1. Load any effect definition on demand</span>
<span class="text-purple-400">const</span> effect = <span class="text-purple-400">await</span> loadEffect(<span class="text-emerald-400">"fire-border"</span>);

<span class="text-slate-500">// 2. Mount onto any HTML element or canvas</span>
<span class="text-purple-400">const</span> instance = mountEffect(document.getElementById(<span class="text-emerald-400">"hero"</span>), effect, &#123;
  controls: &#123;
    uFlames: [<span class="text-amber-400">1.0</span>, <span class="text-amber-400">0.4</span>, <span class="text-amber-400">0.1</span>],
    uSpeed: <span class="text-amber-400">1.2</span>,
  &#125;,
&#125;);</code></pre>
    </div>
  </div>
</section>
