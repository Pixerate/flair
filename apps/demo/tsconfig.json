{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "types": [],
    "paths": {
      "@pixerate/flair": ["../../src/index.ts"],
      "@pixerate/flair/catalog": ["../../src/catalog/index.ts"],
      "@pixerate/flair/editor": ["../../src/editor/index.ts"],
      "@pixerate/flair/vector": ["../../src/vector/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
