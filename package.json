{
  "name": "@pixerate/flair",
  "version": "0.80.0",
  "description": "Web visual effects and motion graphics: WebGL2 shader effects, animated vector effects, a catalog of ready-made effects, and a UI-agnostic, agent-ready effect editor.",
  "author": "Pixerate",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pixerate/flair.git"
  },
  "homepage": "https://pixerate.github.io/flair/",
  "bugs": "https://github.com/Pixerate/flair/issues",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog/index.js"
    },
    "./catalog/lazy": {
      "types": "./dist/catalog/lazy.d.ts",
      "import": "./dist/catalog/lazy.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor/index.js"
    },
    "./vector": {
      "types": "./dist/vector/index.d.ts",
      "import": "./dist/vector/index.js"
    },
    "./motion": {
      "types": "./dist/motion/index.d.ts",
      "import": "./dist/motion/index.js"
    },
    "./embed": {
      "types": "./dist/embed/index.d.ts",
      "import": "./dist/embed/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "import": "./dist/svelte/index.js"
    },
    "./integrations": {
      "types": "./dist/integrations/index.d.ts",
      "import": "./dist/integrations/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./schemas/effect-document.json": "./dist/schemas/effect-document.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "flair": "dist/cli.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsup && pnpm --filter @pixerate/flair-docs build",
    "start": "HOST=0.0.0.0 node apps/docs/dist/server/entry.mjs",
    "dev": "pnpm --filter demo dev",
    "docs:dev": "pnpm --filter @pixerate/flair-docs dev",
    "docs:build": "pnpm --filter @pixerate/flair-docs build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && pnpm --filter demo typecheck && pnpm --filter @pixerate/flair-docs typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "catalog:meta": "UPDATE_CATALOG_META=1 vitest run src/catalog/lazy.test.ts"
  },
  "keywords": [
    "webgl2",
    "shaders",
    "shadertoy",
    "motion-graphics",
    "animation",
    "svg",
    "effects",
    "generative",
    "editor",
    "ai-agents",
    "react",
    "svelte"
  ],
  "dependencies": {
    "commander": "^12.0.0",
    "gifenc": "^1.0.3"
  },
  "peerDependencies": {
    "@pixerate/editor": ">=0.55.0 <1",
    "react": ">=18",
    "svelte": ">=5"
  },
  "peerDependenciesMeta": {
    "@pixerate/editor": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.12",
    "@pixerate/editor": "^0.165.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svelte": "^5.57.2",
    "tsup": "^8.5",
    "typescript": "^5.9",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20"
  }
}
