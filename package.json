{
  "name": "flair",
  "version": "1.0.0",
  "description": "AI-powered Apple Motion (.motn) generator and automation engine",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "flair": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "motion",
    "apple-motion",
    "motion-graphics",
    "ai",
    "pixerate",
    "vertex-ai",
    "gemini"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/google-vertex": "^5.0.4",
    "@pixerate/ai-core": "file:../pixerate-ai-core",
    "commander": "^12.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  }
}
